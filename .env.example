# Copy to .env and adjust. All RAGSEC_* keys map to ragsec/config.py:Settings.
# ---- backend ----
RAGSEC_LLM_BACKEND=ollama            # ollama | mock  (mock = offline, deterministic, NOT research data)
# Loopback-only and validated at startup: an invalid value PREVENTS startup (not a warning). Allowed hosts are
# exactly 127.0.0.1 or localhost (normalized to 127.0.0.1), http only, path empty or "/". This is a trusted
# server-side setting; UI/documents/retrieved content/API bodies must never change it. It controls where the
# app CONNECTS, not where the Ollama server BINDS — verify binding with scripts/preflight_binding.ps1.
RAGSEC_OLLAMA_URL=http://127.0.0.1:11434

# ---- VRAM profile: pick for YOUR GPU ----
# vram_4gb      : one model at a time, embeddings on CPU, short contexts
# vram_6gb      : default for RTX 4050 (6 GB) — small target + guard co-resident, embeddings on CPU
# vram_8gb_plus : target + guard + embed co-resident, longer contexts
RAGSEC_VRAM_PROFILE=vram_6gb

# ---- models (defaults chosen for the 6 GB profile) ----
RAGSEC_DEFAULT_TARGET_MODEL=exaone3.5:2.4b
RAGSEC_EMBEDDING_MODEL=bge-m3
RAGSEC_GUARD_MODEL=llama-guard3:1b
# allowed_target_models / other list fields: set as JSON, e.g.
# RAGSEC_ALLOWED_TARGET_MODELS=["exaone3.5:2.4b","exaone3.5:7.8b","qwen3:4b"]

# ---- API ----
RAGSEC_API_HOST=127.0.0.1
RAGSEC_API_PORT=8000
RAGSEC_API_KEY=change-me-local-only     # min 8 chars; the Streamlit UI must use the same value

# ---- authentication boundary ----
# legacy   : the single shared RAGSEC_API_KEY authorizes everything (default; backward compatible)
# multiuser : per-principal tokens from RAGSEC_PRINCIPALS_FILE map to identity/tenant/roles; the shared key is
#             accepted only if RAGSEC_ALLOW_LEGACY_KEY=true (disabled by default). Provision with `ragsec user-add`.
RAGSEC_AUTH_MODE=legacy
RAGSEC_PRINCIPALS_FILE=policies/principals.json
RAGSEC_ALLOW_LEGACY_KEY=false

# ---- ingestion / answer options ----
RAGSEC_ARTICLE_AWARE_CHUNKING=false     # prefer Korean legal article boundaries for legislation/internal_policy
RAGSEC_CITATION_POLICY=annotate         # annotate | block (block refuses answers citing non-provided evidence)

# ---- reproducibility ----
RAGSEC_SEED=20261027
RAGSEC_TEMPERATURE=0.0

# ---- deadlines / concurrency (serialized GPU by default) ----
RAGSEC_REQUEST_DEADLINE_S=180
RAGSEC_LLM_CALL_TIMEOUT_S=150
RAGSEC_GUARD_CALL_TIMEOUT_S=30
RAGSEC_MAX_CONCURRENT_REQUESTS=1

# ---- raw-artifact store (opt-in; synthetic data only) ----
RAGSEC_RAW_ARTIFACT_STORE=false
RAGSEC_RAW_ARTIFACT_RETENTION_DAYS=14

# ---- optional Gemini utility judge (OFF by default; supplementary only) ----
RAGSEC_GEMINI_ENABLED=false
# RAGSEC_GEMINI_API_KEY=...
RAGSEC_GEMINI_MODEL=gemini-2.5-flash
